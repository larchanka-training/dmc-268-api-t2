# Скопируйте в .env: cp .env.example .env

# PostgreSQL (в docker compose хост = db)
POSTGRES__HOST=db
POSTGRES__PORT=5432
POSTGRES__USER=postgres
POSTGRES__PASSWORD=postgres
POSTGRES__DB=postgres

# Redis
REDIS__URL=redis://redis:6379/0

# Sentry. Empty DSN leaves the SDK off (local runs and CI).
# The value is a project DSN from sentry.io, supplied at deploy time.
SENTRY__DSN=

# Логирование
LOGGING__LEVEL=INFO
# console — человекочитаемый формат (локально), json — структурный (прод)
LOGGING__FORMAT=console
LOGGING__FILE_ENABLED=true
LOGGING__FILE_PATH=logs/app.log

# LLM gateway (docs/llm-gateway-review-pipeline.md §6)
# Локально — только Ollama, без внешнего провайдера и ключа.
# Целевой режим: PRIMARY_PROVIDER=eurorouter, FALLBACK_ENABLED=true.
LLM__PRIMARY_PROVIDER=ollama
LLM__FALLBACK_ENABLED=false

# Eurorouter (основной провайдер). Ключи — СЕКРЕТ, только из CI/CD;
# несколько ключей — через запятую.
LLM__EUROROUTER__BASE_URL=
LLM__EUROROUTER__MODEL=
LLM__EUROROUTER__API_KEYS=
LLM__EUROROUTER__TIMEOUT_S=120

# Ollama (резервный провайдер)
LLM__OLLAMA__BASE_URL=http://ollama:11434
LLM__OLLAMA__MODEL=qwen2.5-coder:14b
LLM__OLLAMA__TIMEOUT_S=120

# Общие лимиты (SD §14)
LLM__PROMPT_VERSION=v1
LLM__CONTEXT_WINDOW=16384
LLM__MAX_INPUT_TOKENS=10000
LLM__MAX_OUTPUT_TOKENS=2000
LLM__REQUEST_TIMEOUT_S=120
LLM__RUN_MAX_REQUESTS=8
LLM__RUN_MAX_INPUT_TOKENS=80000
LLM__RUN_MAX_OUTPUT_TOKENS=16000
LLM__RUN_DEADLINE_S=600
LLM__MAX_CHUNKS=5

# Опциональные секреты времени выполнения — конвенция имён в
# docs/staging-deployment.md; раскомментируйте и заполните при необходимости:
# WEBHOOK__SECRET=
# Токен чтения для webhook intake.
# GITHUB__TOKEN=
# Отдельный токен публикации и числовой ID его bot user; нужны оба значения.
# GITHUB__WRITE_TOKEN=
# GITHUB__BOT_USER_ID=

# GitHub browser OAuth (AUTH-01). Empty values disable auth, not application startup.
# Supply secrets through runtime environment. Never reuse GITHUB__TOKEN here.
AUTH__GITHUB_CLIENT_ID=
AUTH__GITHUB_CLIENT_SECRET=
# Register this exact public HTTPS callback in the GitHub OAuth app.
AUTH__GITHUB_REDIRECT_URI=
# Independent random signing secret, at least 32 bytes (HS256).
AUTH__JWT_SECRET=
# Fernet key for GitHub credentials; distinct from AUTH__JWT_SECRET.
# Generate once for initial setup:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Preserve the entire value, including the trailing '='.
# Keep the existing key on ordinary restarts; do not generate a replacement.
# Replacing it without migration makes previously encrypted GitHub credentials unreadable.
# Never put real keys in Git, test reports, or logs.
AUTH__CREDENTIAL_KEY=
# Exact frontend origins for session mutations, as a JSON array. No wildcard.
# AUTH__FRONTEND_ORIGINS=["https://your-frontend.example"]
AUTH__FRONTEND_ORIGINS=[]
