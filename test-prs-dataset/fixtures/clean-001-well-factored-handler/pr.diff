+def find_user_by_email(connection, email):
+    cursor = connection.cursor()
+    cursor.execute(
+        "SELECT id, email FROM users WHERE email = %s",
+        (email,),
+    )
+    row = cursor.fetchone()
+    return row if row is not None else None
