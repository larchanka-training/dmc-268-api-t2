# Immutable image tags produced by CI/CD.
API_IMAGE=ghcr.io/larchanka-training/dmc-268-api-t2:sha-REPLACE_ME
UI_IMAGE=ghcr.io/larchanka-training/dmc-268-ui-t2:sha-REPLACE_ME

# Хостовый порт web-контейнера (staging: 80, develop-окружение: 8080)
WEB_PORT=80

POSTGRES__USER=dmc
POSTGRES__PASSWORD=REPLACE_WITH_SECRET
POSTGRES__DB=dmc

# Both worker profiles stay off until explicitly enabled for staging.
# Deploy uses independent STAGING_ANALYSIS_ENABLED/STAGING_PUBLICATION_ENABLED.
COMPOSE_PROFILES=
ANALYSIS__CONFIG_PATH=
# Rule Playground is independent of both worker profiles and defaults to off.
# Deploy maps STAGING_SIMULATION_ENABLED (strict true/false) only for staging;
# develop always receives false and no manifest path from the writer.
SIMULATION__ENABLED=false
# Staging reuses the existing root-owned manifest and /app/runtime:ro mount,
# even when analysis is off. No second manifest or model selector.
SIMULATION__MANIFEST_PATH=/app/runtime/analysis-runtime.v1.json
# Dedicated admission URL is optional while disabled; never falls back to REDIS__URL.
# Keep empty in B2A. Future approved target: redis://simulation-redis:6379/0.
# Compose forwards this setting only to api; deployment writer does not deliver it yet.
SIMULATION__REDIS_URL=
# E1-B2A does not deliver HMAC, provision admission state, or implement recovery gates.
# Keep Playground disabled until E1-B2B/E1-B2C and separate activation approval.
# Current deployment profile lists: empty, analysis, publication, analysis,publication.
# The separate simulation profile is local architecture only; do not add it here.
# Its /data volume is external and project-prefixed; absent volume must fail startup.
# Analysis alone: COMPOSE_PROFILES=analysis and
# ANALYSIS__CONFIG_PATH=/app/runtime/analysis-runtime.v1.json.
# Publication needs its own write token/bot ID, no LLM manifest or key.
# The deployment's existing API manifest installation still runs separately.
# Provision ./analysis-runtime/analysis-runtime.v1.json on the VPS first;
# see docs/staging-deployment.md. The manifest contains no secret values.

# LLM gateway (docs/llm-gateway-review-pipeline.md §6, §6a).
# Until Ollama is deployed to staging: eurorouter without fallback.
LLM__PRIMARY_PROVIDER=eurorouter
LLM__FALLBACK_ENABLED=false
LLM__EUROROUTER__BASE_URL=https://REPLACE_ME/v1
LLM__EUROROUTER__MODEL=REPLACE_ME
# Secret from GitHub Actions (STAGING_EUROROUTER_API_KEYS); comma-separated.
LLM__EUROROUTER__API_KEYS=REPLACE_WITH_SECRET
LLM__OLLAMA__BASE_URL=http://ollama:11434
LLM__OLLAMA__MODEL=

# Опциональные секреты времени выполнения — деплой-workflow прокидывает их
# сюда из GitHub Encrypted Secrets, если те заданы; конвенция имён —
# docs/staging-deployment.md. Вручную сюда обычно писать не нужно:
# WEBHOOK__SECRET=
# Токен чтения для webhook intake.
# GITHUB__TOKEN=
# Отдельный токен публикации и числовой ID его bot user; нужны оба значения.
# GITHUB__WRITE_TOKEN=
# GITHUB__BOT_USER_ID=
# Sentry project DSN. API, analysis, intake и publication. Пустое значение не пишется.
# SENTRY__DSN=
# Вход через GitHub в браузере. Только сервис api. Пустое значение деплой не пишет.
# AUTH__GITHUB_CLIENT_ID=
# AUTH__GITHUB_CLIENT_SECRET=
# AUTH__GITHUB_REDIRECT_URI=https://dmc268-t2.ddns.net/api/v1/auth/github/callback
# AUTH__JWT_SECRET=
# AUTH__CREDENTIAL_KEY=
# AUTH__FRONTEND_ORIGINS=["https://dmc268-t2.ddns.net"]
