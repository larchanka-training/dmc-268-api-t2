# Скопируйте в .env: cp .env.example .env

# PostgreSQL (в docker compose хост = db)
POSTGRES__HOST=db
POSTGRES__PORT=5432
POSTGRES__USER=postgres
POSTGRES__PASSWORD=postgres
POSTGRES__DB=postgres

# Redis
REDIS__URL=redis://redis:6379/0

# Логирование
LOGGING__LEVEL=INFO
# console — человекочитаемый формат (локально), json — структурный (прод)
LOGGING__FORMAT=console
LOGGING__FILE_ENABLED=true
LOGGING__FILE_PATH=logs/app.log
